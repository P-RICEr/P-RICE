# Copy this file to .env (same folder) and paste your own key.
# .env is ignored by git: never commit the real key.
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional: which Gemini model to try first (falls back to newer ones automatically)
GEMINI_MODEL=gemini-flash-latest
# Optional: websites allowed to call this API from a browser (comma-separated).
# Leave empty for local use (localhost:5173 and localhost:4173).
ALLOWED_ORIGINS=
